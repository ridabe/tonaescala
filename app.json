{
  "expo": {
    "name": "ToNaEscala",
    "slug": "tonaescala",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tonaescala",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F766E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tonaescala.app"
    },
    "android": {
      "package": "com.tonaescala.app",
      "versionCode": 1,
      "edgeToEdge": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0F766E"
      },
      "permissions": [],
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0F766E"
        }
      ],
      "expo-secure-store",
      "expo-crypto"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
